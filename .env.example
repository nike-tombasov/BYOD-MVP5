# BYOD backend pilot environment variables (Stage X)

# LiveKit URL used by backend when issuing connect payload.
BYOD_LIVEKIT_URL=ws://127.0.0.1:7880

# LiveKit access credentials. Set from VPS deploy secret, do not commit real values.
BYOD_LIVEKIT_API_KEY=replace_me
BYOD_LIVEKIT_API_SECRET=replace_me_with_long_secret

# Backend bind settings.
BYOD_BACKEND_HOST=127.0.0.1
BYOD_BACKEND_PORT=8000

# Listener web origin allowed by CORS (single origin only for pilot).
BYOD_CORS_ALLOWED_ORIGIN=http://LISTENER_PUBLIC_HOST

# Backend persistence files.
BYOD_DATA_DIR=/opt/byod/backend_data
BYOD_ROOM_CONFIG_PATH=/opt/byod/backend_data/room_config_v1.json
BYOD_RUNTIME_STATE_PATH=/opt/byod/backend_data/runtime_state_v1.json
BYOD_RECORDING_STATE_PATH=/opt/byod/backend_data/recording_state_v1.json

# Pilot bootstrap default PIN (used only on clean deploy with no persisted config).
BYOD_DEFAULT_PIN=123456

# Emergency/stress numeric backend limits are edited in the top operator block
# of src/backend/config.py, then applied by restarting byod-backend.
